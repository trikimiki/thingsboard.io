---
import CategoryChip from './CategoryChip.astro';
import { getLabel, typeLabels } from '~/data/iot-hub/constants';
import type { IotHubFullItem, TemplateType } from '~/data/iot-hub/types';

interface Props {
	item: IotHubFullItem;
	type: TemplateType;
}

const { item, type } = Astro.props;

function formatCount(n: number): string {
	if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
	return String(n);
}

function formatDate(ts: number): string {
	return new Date(ts).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

/** Generate a consistent hue from a string for chip coloring */
function stringToHue(str: string): number {
	let hash = 0;
	for (let i = 0; i < str.length; i++) {
		hash = str.charCodeAt(i) + ((hash << 5) - hash);
	}
	return Math.abs(hash) % 360;
}

const isCompact = type === 'calculated-fields' || type === 'rule-chains';
const nodes = (item.dataDescriptor?.nodes as { name: string; type: string }[] | undefined) ?? [];
const nodeCount = (item.dataDescriptor?.nodeCount as number | undefined) ?? nodes.length;
const subtype = (item.dataDescriptor?.cfType ?? item.dataDescriptor?.ruleChainType ?? item.dataDescriptor?.widgetType) as string | undefined;
---

<div class:list={['ih-detail-hero', { 'ih-detail-hero--compact': isCompact }]}>
	{/* Image variant (dashboards/widgets) */}
	{!isCompact && (
		<div class="ih-detail-image">
			{item.imageUrl ? (
				<img src={item.imageUrl} alt={item.name} />
			) : (
				<div class="ih-detail-placeholder">
					<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="ih-fallback-icon" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
				</div>
			)}
		</div>
	)}

	{/* Compact icon (CF/RC) */}
	{isCompact && (
		<div class="ih-detail-compact-icon" style={item.color ? `background: ${item.color}` : undefined}>
			{item.icon ? (
				<span class="material-icons">{item.icon}</span>
			) : (
				<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
			)}
		</div>
	)}

	<div class="ih-detail-info">
		<div class="ih-detail-name-row">
			<h1 class="ih-detail-name">{item.name}</h1>
			{subtype && (
				<span
					class="ih-detail-subtype-chip"
					style={`--chip-hue: ${stringToHue(subtype)}`}
				>{getLabel(subtype)}</span>
			)}
		</div>
		<div class="ih-detail-meta-row">
			<span class="ih-detail-meta-item">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
				{item.creatorDisplayName}
			</span>
			<span class="ih-detail-sep">·</span>
			<span class="ih-detail-meta-item">v{item.version}</span>
			<span class="ih-detail-sep">·</span>
			<span class="ih-detail-meta-item" title={`${item.totalInstallCount} total installs`}>
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
				{formatCount(item.totalInstallCount)}
			</span>
			<span class="ih-detail-sep">·</span>
			<span class="ih-detail-meta-item">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
				{formatDate(item.publishedTime)}
			</span>
		</div>
		{item.description && <p class="ih-detail-desc">{item.description}</p>}

		{/* Rule chain nodes */}
		{type === 'rule-chains' && nodes.length > 0 && (
			<div class="ih-detail-nodes">
				{nodes.map((node) => (
					<span class="ih-node-pill">{node.name}</span>
				))}
				{nodeCount > nodes.length && <span class="ih-node-pill ih-node-more">+{nodeCount - nodes.length}</span>}
			</div>
		)}

		<div class="ih-detail-chips">
			{item.peOnly && <CategoryChip label="PE Only" variant="pe" />}
			<CategoryChip label={typeLabels[type]} />
			{item.categories.map((cat) => (
				<CategoryChip label={getLabel(cat)} />
			))}
			{item.useCases.map((uc) => (
				<CategoryChip label={getLabel(uc)} />
			))}
		</div>
	</div>
</div>

<style>
	.ih-detail-hero {
		display: grid;
		grid-template-columns: 320px 1fr;
		gap: 1.5rem;
		align-items: start;
	}

	/* Compact layout: small icon + info */
	.ih-detail-hero--compact {
		grid-template-columns: 56px 1fr;
		gap: 1rem;
	}

	/* --- Image (dashboards/widgets) --- */
	.ih-detail-image {
		aspect-ratio: 16 / 10;
		background: var(--sl-color-gray-6);
		border-radius: 0.5rem;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.ih-detail-image img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.ih-detail-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
	}

	.ih-fallback-icon {
		color: var(--sl-color-gray-3);
	}

	/* --- Compact icon (CF/RC) --- */
	.ih-detail-compact-icon {
		width: 56px;
		height: 56px;
		border-radius: 0.75rem;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		color: #fff;
	}

	.ih-detail-compact-icon svg {
		color: #fff;
	}

	/* --- Info --- */
	.ih-detail-info {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.ih-detail-name-row {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		flex-wrap: wrap;
	}

	.ih-detail-name {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0;
		color: var(--sl-color-text);
	}

	.ih-detail-subtype-chip {
		display: inline-block;
		padding: 0.125rem 0.625rem;
		font-size: 0.75rem;
		font-weight: 600;
		line-height: 1.5;
		border-radius: 1rem;
		white-space: nowrap;
		background: hsl(var(--chip-hue, 210) 60% 93%);
		color: hsl(var(--chip-hue, 210) 50% 35%);
	}

	.ih-detail-meta-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		color: var(--sl-color-gray-2);
		flex-wrap: wrap;
	}

	.ih-detail-meta-item {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
	}

	.ih-detail-sep {
		color: var(--sl-color-gray-4);
		user-select: none;
	}

	.ih-detail-desc {
		font-size: 0.9375rem;
		color: var(--sl-color-text);
		line-height: 1.5;
		margin: 0.25rem 0 0;
	}

	/* --- Node pills (rule chains detail) --- */
	.ih-detail-nodes {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}

	.ih-detail-nodes :global(.ih-node-pill) {
		padding: 0.25rem 0.625rem;
		font-size: 0.75rem;
	}

	.ih-detail-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin-top: 0.25rem;
	}

	@media (max-width: 768px) {
		.ih-detail-hero {
			grid-template-columns: 1fr;
		}
		.ih-detail-image {
			max-width: 400px;
		}
		.ih-detail-hero--compact {
			grid-template-columns: 56px 1fr;
		}
	}
</style>
